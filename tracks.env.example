# Copy to .env and set your host paths before running Compose.
MUSIC_PATH=/srv/music
DOWNLOADS_PATH=/srv/downloads

# Optional: your slskd address (without /api/v0), API key and shared downloads.
# A host service is usually reachable through its LAN IP from Docker.
LIDARR_SLSKD_URL=http://192.168.1.100:5030
LIDARR_SLSKD_API_KEY=replace-with-your-slskd-api-key

# Configure slskd's completed download directory as /srv/downloads/slskd
# on the host, or mount that same host folder in its container.

# Optional Cadence song request / playlist companion.
# Find the Lidarr API key under Settings > General (show advanced).
CADENCE_LIDARR_API_KEY=replace-with-your-lidarr-api-key
CADENCE_ADMIN_USER=admin
# Used only to create the first admin account; at least 10 characters.
CADENCE_ADMIN_PASSWORD=replace-with-a-long-unique-password
CADENCE_PORT=8787
# Set true when accessing Cadence through an HTTPS reverse proxy.
CADENCE_SECURE_COOKIE=false
