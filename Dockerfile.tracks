FROM node:22-bookworm-slim AS frontend
WORKDIR /build
RUN corepack enable && corepack prepare yarn@1.22.19 --activate
COPY package.json yarn.lock .yarnrc ./
RUN yarn install --frozen-lockfile --ignore-scripts --network-timeout 600000
COPY frontend ./frontend
RUN yarn build --env production

FROM mcr.microsoft.com/dotnet/sdk:8.0.421 AS backend
WORKDIR /build
COPY global.json ./
COPY src ./src
COPY Logo ./Logo
RUN dotnet build src/NzbDrone.Console/Lidarr.Console.csproj -c Release -p:EnableAnalyzers=false -p:RuntimeIdentifiers=linux-x64
RUN dotnet build src/NzbDrone.Mono/Lidarr.Mono.csproj -c Release -p:EnableAnalyzers=false -p:RuntimeIdentifiers=linux-x64

FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libsqlite3-0 libchromaprint-tools mediainfo ffmpeg libgdiplus && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend /build/_output/net8.0/ ./
COPY --from=frontend /build/_output/UI/ ./UI/
EXPOSE 8686
ENTRYPOINT ["dotnet", "Lidarr.dll", "-nobrowser", "-data=/config"]
